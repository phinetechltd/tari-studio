# Template for /var/www/tari-studio/app/.env on the server. bootstrap-server.sh fills the __PLACEHOLDERS__.
# Never commit the real file. Every provider key below can instead be saved in Platform admin -> Settings.

NODE_ENV=production
DATABASE_URL="postgresql://tari:__DB_PASS__@127.0.0.1:5432/tari_studio?schema=public&connection_limit=8"
AUTH_SECRET="__AUTH_SECRET__"
CREDENTIALS_KEY="__CREDENTIALS_KEY__"
HEALTH_TOKEN="__HEALTH_TOKEN__"
ACCESS_TOKEN_TTL_MIN=720
REQUIRE_TOTP=true

NEXT_PUBLIC_PRODUCT_NAME="Tari Studio"
APP_BASE_URL="https://__DOMAIN__"
STORAGE_DIR="/var/www/tari-studio/storage"

# Email: required for sign-up and password recovery. Gmail needs an app password (2-Step Verification on).
EMAIL_PROVIDER=smtp
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="phinetechltd@gmail.com"
SMTP_PASSWORD=""
EMAIL_FROM="phinetechltd@gmail.com"
EMAIL_FROM_NAME="Tari Studio"
EMAIL_REPLY_TO="phinetechltd@gmail.com"

# Production refuses simulators. Until real keys are added the matching features report "not configured".
SMS_PROVIDER=off
PAYSTACK_PROVIDER=off
# PAYMENT_PROVIDER=daraja   # + MPESA_* keys
# GENERATION_PROVIDER=higgsfield   # + HF_CREDENTIALS
# AI_PROVIDER=anthropic   # + ANTHROPIC_API_KEY
# META_PROVIDER=graph   # + META_* keys

# Google sign-in is switched on in Platform admin -> Settings -> Google sign-in.
