# Copy to .env and fill in. Never commit .env.
# Generate secrets on the machine that will use them; do not copy them between machines.

# ── Database ───────────────────────────────────────────────────────────
# Dev/test use the embedded Postgres started by `npm run pg:start` (port 54329).
DATABASE_URL="postgresql://agency:agency@127.0.0.1:54329/agency_dev?schema=public&connection_limit=5"
TEST_DATABASE_URL="postgresql://agency:agency@127.0.0.1:54329/agency_test?schema=public&connection_limit=5"

# ── Auth ───────────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=""
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# ── Credential vault (Meta tokens etc.) ────────────────────────────────
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored channel token unreadable; they must be re-connected.
CREDENTIALS_KEY=""

# ── Product identity (see src/lib/brand.ts) ────────────────────────────
NEXT_PUBLIC_PRODUCT_NAME="Tari Studio"
APP_BASE_URL="http://localhost:3400"

# ── Providers (adapters refuse the simulator/console in production) ─────
EMAIL_PROVIDER="console"        # console | smtp
# SMTP (any provider). Also settable in Platform admin → Settings → Email (SMTP).
SMTP_HOST=""
SMTP_PORT="587"                 # 587 with STARTTLS, or 465 with SMTP_SECURE="true"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""                   # e.g. hello@yourdomain.co.ke (the SMTP account must be allowed to send as it)
EMAIL_FROM_NAME=""              # defaults to the product name
EMAIL_REPLY_TO=""

# SMS notifications through Bonga (bongasms.co.ke). console = log only (refused in production); off = none.
SMS_PROVIDER="console"          # bonga | console | off
BONGA_SMS_CLIENT_ID=""
BONGA_SMS_API_KEY=""
BONGA_SMS_API_SECRET=""
BONGA_SMS_SERVICE_ID=""
# BONGA_SMS_ENDPOINT="http://167.172.14.50:4002/v1/send-sms"   # Bonga's default
SMS_DAILY_CAP="300"             # platform-wide; texts past it are logged, not sent

# ── AI (captions, briefs, WhatsApp replies) ────────────────────────────
# anthropic = Claude through the official SDK. fixtures = canned text, for development only.
AI_PROVIDER="anthropic"         # anthropic | nvidia | fixtures
ANTHROPIC_API_KEY=""            # from console.anthropic.com; the operator's key, never a tenant's
AI_MODEL="claude-sonnet-5"      # captions, briefs, WhatsApp replies
AI_CHEAP_MODEL="claude-haiku-4-5" # quick one-line tasks
AI_TIMEOUT_SEC=45
# Optional fallback order, tried left to right when a provider times out or errors:
# AI_FALLBACK_CHAIN="anthropic:claude-sonnet-5,nvidia:nvidia-nemotron-3-super"
NVIDIA_API_KEY=""

# ── Meta: Facebook Pages, Instagram and the WhatsApp Cloud API ─────────
# simulator = everything works end to end without a Meta app (development only).
# graph     = live. Needs a Meta app with Facebook Login, the Pages/Instagram permissions
#             and the WhatsApp product. OAuth redirect: APP_BASE_URL/api/channels/meta/callback
#             WhatsApp webhook: APP_BASE_URL/api/webhooks/whatsapp (field: messages)
META_PROVIDER="simulator"       # simulator | graph
META_APP_ID=""
META_APP_SECRET=""              # also verifies every webhook signature
META_GRAPH_VERSION="v23.0"
META_WEBHOOK_VERIFY_TOKEN=""    # any long random string; paste the same value into the Meta app

# ── M-Pesa STK push (Safaricom Daraja) ─────────────────────────────────
# "simulator" pretends to collect, for development; production refuses it.
# Sandbox: shortcode 174379 with the sandbox passkey from developer.safaricom.co.ke,
# plus your own app's consumer key and secret. The callback must be public HTTPS
# in production: APP_BASE_URL + /api/payments/mpesa/callback.
PAYMENT_PROVIDER="simulator"
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till; set MPESA_PARTY_B to the till)
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_PARTY_B=""

# Paystack: cards, M-Pesa and Apple Pay on Paystack's checkout, and card renewals
# for plans. "simulator" in development; "paystack" live; "off" = M-Pesa only.
# Webhook URL in the Paystack dashboard: APP_BASE_URL/api/webhooks/paystack
PAYSTACK_PROVIDER="simulator"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""    # pk_live_…; lets the console show the card form inline

# ── TikTok (posting; comment replies through the Business API) ────────
# Also settable in Platform admin → Settings → TikTok. simulator = pretend (refused in production); off = no TikTok.
TIKTOK_PROVIDER="simulator"     # live | simulator | off
TIKTOK_CLIENT_KEY=""            # developers.tiktok.com app (Login Kit + Content Posting API)
TIKTOK_CLIENT_SECRET=""         # also signs TikTok's webhooks
TIKTOK_BUSINESS_APP_ID=""       # optional: business-api.tiktok.com app, for comment replies
TIKTOK_BUSINESS_SECRET=""

# ── Pinterest (organisations' own pins as template sources) ───────────
PINTEREST_PROVIDER="simulator"  # live | simulator | off (off still allows pasted pin links)
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_PARTNER_SEARCH="off"  # "on" only once Pinterest grants partner search

# ── Search engines (also in Platform admin → Settings → Search engines) ──
# APP_BASE_URL above must be the live https address: canonical links and the sitemap use it,
# and a non-https copy tells crawlers to stay out.
GOOGLE_SITE_VERIFICATION=""     # Search Console "HTML tag" content value (or verify by DNS and leave empty)
BING_SITE_VERIFICATION=""       # optional, msvalidate.01
SEO_SOCIAL_PROFILES=""          # comma-separated official profile URLs

# ── Image and video generation (Higgsfield) ────────────────────────────
# "simulator" returns sample media, for development; production refuses it.
GENERATION_PROVIDER="simulator"
# KEY_ID:KEY_SECRET from the Higgsfield dashboard
HF_CREDENTIALS=""
# Where generated files are kept (relative to the app directory)
STORAGE_DIR="storage"

# ── Public orders ──────────────────────────────────────────────────────
# Slug of the organisation that owns orders placed on the landing page
ORDERS_ORGANIZATION_SLUG="demo-agency"
